{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom", "chrome"],
    "paths": {
      "@motionlab/core": ["./packages/core/src/index.ts"],
      "@motionlab/core/*": ["./packages/core/src/*"],
      "@motionlab/dialkit": ["./packages/dialkit/src/index.ts"],
      "@motionlab/react": ["./packages/react/src/index.ts"],
      "@motionlab/devtools": ["./packages/devtools/src/index.ts"],
      "motionlab": ["./packages/motionlab/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "apps/extension/**/*.ts",
    "apps/extension/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**"]
}
