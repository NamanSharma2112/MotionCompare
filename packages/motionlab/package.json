{
  "name": "motionlab",
  "version": "0.2.0",
  "description": "MotionLab \u2014 select a real component, compare motion configurations side by side, tune, choose and copy the result into your code.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
