    "@motionlab/devtools": "0.2.0",
    "@motionlab/dialkit": "0.2.0",
    "@motionlab/react": "0.2.0",
    "@motionlab/server": "0.4.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
