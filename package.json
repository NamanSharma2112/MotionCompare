{
  "name": "motionlab-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "MotionLab \u2014 select a real component, compare motion configurations, tune, choose, export.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @motionlab/playground",
    "dev:example": "npm run dev --workspace @motionlab/example-nextjs",
    "build": "npm run build --workspace @motionlab/playground",
    "build:extension": "npm run build --workspace @motionlab/extension",
    "start": "npm run start --workspace @motionlab/playground",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  }
}
